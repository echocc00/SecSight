# SecSight 部署环境变量 (复制为 .env 后填写)
# ⚠️ 真实密钥禁止提交到 git

# ============ LLM 网关 (LiteLLM) ============
# 境内厂商(生产主链路)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MINIMAX_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MINIMAX_BASE_URL=https://api.minimax.chat/v1
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 境外厂商(仅脱敏后备选,默认禁用)
CLAUDE_API_KEY=
OPENAI_API_KEY=
ENABLE_FOREIGN_LLM=false

# LiteLLM 主路由
LITELLM_MASTER_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LITELLM_MODEL_TIER1=minimax/abab6.5-chat          # 简单分诊
LITELLM_MODEL_TIER2=deepseek/deepseek-chat        # 复杂调查推理
LITELLM_MODEL_TIER3=deepseek/deepseek-coder       # 代码/剧本生成
LITELLM_MODEL_AUDIT=claude-sonnet                 # 高风险审计(脱敏后备选)

# ============ 真实 LLM provider (mock_mode=false 时生效) ============
# minimax = MiniMax 直连 (OpenAI 兼容); litellm = 经 LiteLLM 网关
LLM_PROVIDER=minimax
MINIMAX_API_KEY=填入你的MiniMax API key
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=abab6.5s-chat
LLM_TIMEOUT_SECONDS=60
LLM_FALLBACK_TO_MOCK=true                         # 真 LLM 故障时降级回 mock

# ============ Wazuh ============
WAZUH_MANAGER_PASSWORD=ChangeMe_123!
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=ChangeMe_123!
WAZUH_INDEXER_PASSWORD=ChangeMe_123!
WAZUH_AGENT enrollment_password=ChangeMe_123!

# ============ OpenSearch ============
OPENSEARCH_INITIAL_ADMIN_PASSWORD=ChangeMe_123!Strong
OPENSEARCH_PASSWORD=ChangeMe_123!

# ============ Shuffle (AGPL 隔离) ============
SHUFFLE_DEFAULT_USERNAME=admin@secsight.local
SHUFFLE_DEFAULT_PASSWORD=ChangeMe_123!
SHUFFLE_API_KEY=

# ============ OpenCTI ============
OPENCTI_ADMIN_EMAIL=admin@secsight.local
OPENCTI_ADMIN_PASSWORD=ChangeMe_123!Strong
OPENCTI_ADMIN_TOKEN=ChangeMe_OpenCTI_Token
OPENCTI_HEALTHCHECK_KEY=

# ============ DFIR-IRIS (LGPL) ============
IRIS_ADMIN_PASSWORD=ChangeMe_123!Strong
IRIS_SECRET_KEY=ChangeMe_IRIS_Secret
IRIS_POSTGRES_PASSWORD=ChangeMe_123!

# ============ Postgres (SecSight 主体) ============
POSTGRES_USER=secsight
POSTGRES_PASSWORD=ChangeMe_123!Strong
POSTGRES_DB=secsight
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============ Qdrant ============
QDRANT_API_KEY=ChangeMe_Qdrant_Key

# ============ 威胁情报 (免费源) ============
ABUSEIPDB_API_KEY=注册 abuseipdb.com 免费获取
OTX_API_KEY=注册 otx.alienvault.com 免费获取(可选,无 key 也能用但限速)
# MISP 社区 feed (无需 key, URL 即可)
MISP_COMMUNITY_URL=https://www.circl.lu/doc/misp/feed-osint/
ENABLE_THREAT_INTEL=false                          # true=用真实 AbuseIPDB+OTX; false=mock
THREAT_INTEL_TIMEOUT_SECONDS=10
THREAT_INTEL_FALLBACK_TO_MOCK=true                 # 真实 API 失败降级 mock

# 付费情报 provider 接口预留(很长一段时间不接入)
THREATBOOK_API_KEY=
QIANXIN_API_KEY=
QIHU360_API_KEY=

# ============ 飞书/钉钉 审批通知 ============
FEISHU_WEBHOOK_URL=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
DINGTALK_ACCESS_TOKEN=

# ============ SecSight 主体 ============
SECSIGHT_SECRET_KEY=ChangeMe_SecSight_Secret
SECSIGHT_ENV=development
SECSIGHT_LOG_LEVEL=INFO
SECSIGHT_BACKEND_HOST=0.0.0.0
SECSIGHT_BACKEND_PORT=8000
SECSIGHT_FRONTEND_PORT=8080
SECSIGHT_MOCK_MODE=true                           # true=全mock; false=真实LLM/情报/执行
ENABLE_QDRANT=false                               # 真实向量检索 (Qdrant 就绪才开)
ENABLE_SHUFFLE=false                              # 真实 SOAR 执行 (Shuffle 就绪才开)
ENABLE_ALERT_DEDUP=true                           # 告警时间窗聚合 (防告警风暴)
ALERT_DEDUP_WINDOW_MINUTES=5                      # 同 (规则,主机,源IP) 窗口内并入现有 Case
ENABLE_KNOWLEDGE_SEDIMENT=true                    # Case 闭环后自动沉淀知识 (L3→L1)
ENABLE_PROACTIVE_SCHEDULER=false                  # Proactive Agent 定时调度

# 数据合规开关
REQUIRE_DOMESTIC_LLM=true                      # 生产强制境内 LLM
PII_REDACTION_ENABLED=true                      # 入库前脱敏
AUDIT_LOG_RETENTION_DAYS=180

# ============ 速率限制 ============
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=redis://redis:6379/1     # memory:// = 单副本; 多副本必须用 Redis
RATE_LIMIT_LOGIN=5/minute                       # 登录暴破防护
RATE_LIMIT_INJECT=30/minute                     # 人工注入告警
RATE_LIMIT_WEBHOOK=600/minute                   # 机器推送 (Wazuh/国产设备/审批回调)
RATE_LIMIT_SEARCH=60/minute                     # 全文检索
RATE_LIMIT_APPROVAL=120/minute                  # 审批提交
RATE_LIMIT_DEFAULT=1000/minute                  # 其余端点兜底

# ============ 认证令牌 ============
ACCESS_TOKEN_EXPIRE_MINUTES=30                  # access 短时效
REFRESH_TOKEN_EXPIRE_DAYS=7                     # refresh 长时效 (存 hash,可吊销)
SEED_USER_PASSWORD=                             # 留空: 生产随机生成并打印一次;开发用 ChangeMe_123!

# ============ Embedding (RAG 向量化) ============
# tfidf = 无依赖兜底 (256维,只能字面匹配); bge = 本地语义模型 (1024维);
# api = OpenAI 兼容端点。换 provider 后必须重建索引:
#   python scripts/reindex_knowledge.py
EMBEDDING_PROVIDER=tfidf
EMBEDDING_MODEL=BAAI/bge-m3                     # bge: HF 模型名; api: 远端模型名
EMBEDDING_DEVICE=cpu                            # bge: cpu | cuda
EMBEDDING_API_BASE=                             # api: 如 http://vllm:8000/v1
EMBEDDING_API_KEY=
EMBEDDING_FALLBACK_TO_TFIDF=true                # 生产建议 false (快速失败,避免检索质量静默下跌)

# ============ OpenCTI (第 3 情报源, AGPL 隔离, 仅 HTTP GraphQL) ============
ENABLE_OPENCTI=false                            # 容器就绪 + token 配好才开
OPENCTI_TIMEOUT_SECONDS=15
OPENCTI_MALICIOUS_SCORE=50                      # x_opencti_score >= 此值判恶意
